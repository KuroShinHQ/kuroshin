# Kuroshin OS — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is gitignored).

# --- Telegram Bot (optional — for the 26-tool Telegram agent) ---
# Create a bot via @BotFather on Telegram and paste the token here.
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --- WordPress (optional — if you use the WP posting tool) ---
WP_TOKEN=your_wordpress_application_password_here

# --- Crawlee bridge (optional — set to "true" to enable the Crawlee scraper bridge) ---
CRAWLEE_ENABLED=false
