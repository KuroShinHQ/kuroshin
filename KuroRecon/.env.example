# Scraper Paketi — Ortam Değişkenleri (opsiyonel)
# Bu dosyayı .env olarak kopyalayın ve doldurun.
# Konfigürasyon için config.yaml tercih edilir; bu dosya ek override içindir.

# Proxy ayarı (opsiyonel)
SCRAPER_PROXY=

# Sahibinden cookie dosyası yolu (config.yaml'daki cookie_file'ı override eder)
SAHIBINDEN_COOKIE_FILE=cookies.json
